{
  "name": "scrapworks",
  "version": "0.0.1",
  "type": "module",
  "description": "Scrapworks, a browser-first 3D factory-restoration game.",
  "scripts": {
    "ng": "ng",
    "dev": "node tools/scenes/dev.ts",
    "build": "node tools/build/build.ts",
    "build:stats": "yarn build --stats-json",
    "build:prod": "yarn build --configuration production",
    "test": "yarn scenes:export && ng test --watch=false",
    "test:unit": "yarn scenes:export && ng test --configuration=unit --watch=false",
    "test:renderer": "yarn scenes:export && ng test --configuration=renderer --watch=false",
    "test:watch": "yarn scenes:export && ng test --watch",
    "scenes:export": "node tools/scenes/export.ts",
    "test:setup": "playwright install chromium --only-shell",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "yarn run lint:fix && prettier --write src",
    "test:lint": "tsc -p tools/tsconfig.json && vitest run --config vitest.tools.config.ts tools/eslint",
    "docs:check": "node tools/cleanup/check-docs.ts",
    "assets:check": "node tools/scenes/check-export.ts",
    "test:export": "vitest run --config vitest.tools.config.ts tools/scenes",
    "test:world": "vitest run --config vitest.tools.config.ts tools/world",
    "test:tools": "tsc -p tools/tsconfig.json && vitest run --config vitest.tools.config.ts",
    "test:game": "tsc -p tests/tsconfig.json && tsc -p tests/support/tsconfig.reference.json && vitest run --config vitest.game.config.ts",
    "test:acceptance": "node tests/acceptance/production-browser.ts",
    "test:opening": "node tests/acceptance/opening-browser.ts",
    "test:saves": "node tests/acceptance/save-browser.ts",
    "test:workflow": "node tools/scenes/check-dev-workflow.ts",
    "test:labs": "tsc -p tools/tsconfig.json && vitest run --config vitest.labs.config.ts",
    "test:coverage": "yarn test:coverage:tools && yarn test:coverage:game && yarn coverage:report",
    "test:coverage:game": "node tools/coverage/report.ts clean game && yarn scenes:export && yarn test:game --coverage && ng test --watch=false --configuration=coverage && node tools/coverage/report.ts game",
    "test:coverage:tools": "node tools/coverage/report.ts clean tooling && yarn test:tools --coverage && node tools/coverage/report.ts tooling",
    "coverage:report": "node tools/coverage/report.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/googlproxer/scrapworks.git"
  },
  "author": "googlproxer",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/googlproxer/scrapworks/issues"
  },
  "homepage": "https://github.com/googlproxer/scrapworks#readme",
  "keywords": [
    "scrapworks",
    "angular",
    "babylonjs",
    "3d",
    "factory",
    "automation"
  ],
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@babylonjs/addons": "^9.33.1",
    "@babylonjs/core": "^9.33.1",
    "@babylonjs/gui": "^9.33.1",
    "@babylonjs/loaders": "^9.33.1",
    "@babylonjs/materials": "^9.33.1",
    "@dimforge/rapier3d-compat": "0.21.0",
    "@recast-navigation/core": "^0.44.0",
    "@recast-navigation/generators": "^0.44.0",
    "babylonjs-editor-tools": "5.5.2",
    "dexie": "^4.4.7",
    "miniplex": "2.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@babylonjs/gui-editor": "^9.33.1",
    "@babylonjs/inspector": "^9.33.1",
    "@babylonjs/node-editor": "^9.33.1",
    "@babylonjs/node-geometry-editor": "^9.33.1",
    "@babylonjs/node-particle-editor": "^9.33.1",
    "@babylonjs/node-render-graph-editor": "^9.33.1",
    "@babylonjs/serializers": "^9.33.1",
    "@eslint/js": "^10.0.1",
    "@fluentui-contrib/react-resize-handle": "^0.8.4",
    "@fluentui-contrib/react-virtualizer": "^1.0.0",
    "@fluentui/react-components": "^9.75.0",
    "@fluentui/react-icons": "^2.0.345",
    "@fluentui/react-motion-components-preview": "^0.15.10",
    "@fluentui/react-shared-contexts": "^9.26.4",
    "@fluentui/react-utilities": "^9.27.0",
    "@lastolivegames/becsy": "0.16.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/utils": "^8.72.1",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/istanbul-lib-coverage": "1.0.2",
    "@vitest/istanbul-lib-report": "1.0.2",
    "angular-eslint": "22.6.0",
    "axe-core": "4.14.0",
    "babylonjs-editor-cli": "5.5.2",
    "babylonjs-gltf2interface": "^9.33.1",
    "bitecs": "0.4.0",
    "eslint": "^10.14.0",
    "eslint-plugin-prettier": "^5.5.7",
    "jiti": "2.7.0",
    "koota": "0.6.6",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "scrapworks-editor-mcp-plugin": "portal:tools/editor-mcp",
    "sharp": "0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "usehooks-ts": "^3.1.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "fast-xml-parser": "5.11.2",
    "glob": "14.0.2",
    "minimatch": "11.0.1",
    "sharp": "0.35.5"
  }
}
