{
  "name": "scrapworks",
  "version": "0.0.1",
  "type": "module",
  "description": "Scrapworks, a browser-first 3D factory-restoration game.",
  "scripts": {
    "ng": "ng",
    "dev": "node tools/scenes/dev.mjs",
    "build": "yarn scenes:export && ng build",
    "test": "yarn scenes:export && ng test --watch=false",
    "test:unit": "yarn scenes:export && ng test --configuration=unit --watch=false",
    "test:renderer": "yarn scenes:export && ng test --configuration=renderer --watch=false",
    "test:watch": "yarn scenes:export && ng test --watch",
    "scenes:export": "node tools/scenes/export.mjs",
    "editor:mcp:check": "node tools/editor-mcp/check.mjs",
    "test:setup": "playwright install chromium --only-shell",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "yarn run lint:fix && prettier --write src",
    "test:lint": "node --test tools/eslint/*.test.mjs",
    "docs:check": "node tools/cleanup/check-docs.mjs",
    "assets:audit": "node tools/scenes/inventory.mjs --output tmp/asset-audit/latest.json",
    "assets:check": "node tools/scenes/check-export.mjs",
    "test:export": "node --test tools/scenes/*.test.mjs",
    "test:world": "node --test tools/world/*.test.mjs",
    "test:workflow": "node tools/scenes/check-dev-workflow.mjs",
    "cleanup:audit": "node tools/cleanup/audit-repository.mjs --output tmp/cleanup/repository.json",
    "bench:ecs:check": "node tools/ecs-bench/cli.mjs check",
    "bench:ecs:smoke": "node tools/ecs-bench/cli.mjs smoke",
    "bench:ecs:node": "node tools/ecs-bench/cli.mjs node",
    "bench:ecs:browser": "node tools/ecs-bench/cli.mjs browser",
    "bench:ecs:full": "node tools/ecs-bench/cli.mjs full",
    "bench:ecs:report": "node tools/ecs-bench/cli.mjs report",
    "bench:worker:check": "node tools/simulation-worker-bench/cli.mjs check",
    "bench:worker:smoke": "node tools/simulation-worker-bench/cli.mjs smoke",
    "bench:worker:browser": "node tools/simulation-worker-bench/cli.mjs browser",
    "bench:worker:report": "node tools/simulation-worker-bench/cli.mjs report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/googlproxer/scrapworks.git"
  },
  "author": "googlproxer",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/googlproxer/scrapworks/issues"
  },
  "homepage": "https://github.com/googlproxer/scrapworks#readme",
  "keywords": [
    "scrapworks",
    "angular",
    "babylonjs",
    "3d",
    "factory",
    "automation"
  ],
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@babylonjs-toolkit/next": "^9.30.0",
    "@babylonjs/addons": "^9.32.0",
    "@babylonjs/core": "^9.32.0",
    "@babylonjs/gui": "^9.32.0",
    "@babylonjs/loaders": "^9.32.0",
    "@babylonjs/materials": "^9.32.0",
    "@recast-navigation/core": "^0.43.1",
    "@recast-navigation/generators": "^0.43.1",
    "babylonjs-editor-tools": "^5.5.3-alpha.1",
    "dexie": "^4.4.7",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.4",
    "@angular-eslint/builder": "22.6.0",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@babylonjs/gui-editor": "^9.32.0",
    "@babylonjs/inspector": "^9.32.0",
    "@babylonjs/node-editor": "^9.32.0",
    "@babylonjs/node-geometry-editor": "^9.32.0",
    "@babylonjs/node-particle-editor": "^9.32.0",
    "@babylonjs/node-render-graph-editor": "^9.32.0",
    "@babylonjs/serializers": "^9.32.0",
    "@eslint/js": "^10.0.1",
    "@fluentui-contrib/react-resize-handle": "^0.8.4",
    "@fluentui-contrib/react-virtualizer": "^1.0.0",
    "@fluentui/react-components": "^9.74.11",
    "@fluentui/react-icons": "^2.0.344",
    "@fluentui/react-motion-components-preview": "^0.15.10",
    "@fluentui/react-shared-contexts": "^9.26.4",
    "@fluentui/react-utilities": "^9.27.0",
    "@lastolivegames/becsy": "0.16.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "angular-eslint": "22.6.0",
    "axe-core": "4.14.0",
    "babylonjs-editor-cli": "^5.5.3-alpha.1",
    "babylonjs-gltf2interface": "^9.32.0",
    "bitecs": "0.4.0",
    "eslint": "^10.13.0",
    "eslint-plugin-prettier": "^5.5.7",
    "koota": "0.6.6",
    "miniplex": "2.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "scrapworks-editor-mcp-plugin": "portal:tools/editor-mcp",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "usehooks-ts": "^3.1.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@4.18.1"
}
